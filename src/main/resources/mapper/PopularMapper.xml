<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.anime.mapper.PopularMapper">

  <!-- 즐겨찾기 많은 순 TOP mal_id -->
  <!-- ✅ is_favorite 컬럼 제거됨 → row 존재 자체가 즐겨찾기 ON을 의미 -->
  <select id="topAnimeIdsByFavorites" resultType="int">
    SELECT
      mal_anime_id
    FROM my_anime_list
    GROUP BY mal_anime_id
    ORDER BY COUNT(*) DESC, MAX(updated_at) DESC
    LIMIT #{limit}
  </select>

</mapper>